[Unit]
Description=Codex app-server for TailCodex
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/tailcodex/environment
ExecStart=/usr/bin/codex app-server --listen ws://127.0.0.1:4500 --ws-auth capability-token --ws-token-file %h/.config/tailcodex/app-server-token
Restart=on-failure
RestartSec=3
TimeoutStopSec=15

[Install]
WantedBy=default.target
